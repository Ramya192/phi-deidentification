__pycache__/
*.pyc
# Wildcard rather than exact names -- .venv311/ (a second Python version for
# local testing) and .venv_check/ (a scratch env for verifying a from-scratch
# install) both had to be added here after the fact once, so anything named
# .venv* or venv* is excluded up front instead of one at a time.
.venv/
.venv*/
venv/
venv*/
.env
*.egg-info/
.pytest_cache/

# LangGraph checkpoint DB and its WAL/SHM siblings (recreated automatically
# on next startup -- see README's SQLite corruption troubleshooting note)
data/checkpoints.sqlite
data/checkpoints.sqlite-wal
data/checkpoints.sqlite-shm

# Persistent audit trail DB (storage/audit_store.py) and any scratch/test
# databases created during local debugging -- none of these should ship
# with the repo.
data/audit.sqlite
data/audit*.sqlite*
data/scratch*.sqlite*
data/plain_test.txt

# Office lock files (created while a .docx/.pptx is open in Word/PowerPoint
# -- Word opening a .md file, e.g. via "Open With", makes one of these too)
~$*.docx
~$*.pptx
~$*.xlsx
~$*.md

# FUSE/mount artifacts from cross-platform file bridges -- never meaningful
# content, safe to ignore wherever they appear
.fuse_hidden*
data/.fuse_hidden*

# Personal prep/scratch material (presentation notes, pre-submission
# self-evaluation, screenshot source) -- not part of the submitted
# project, not meant for an evaluator to see.
practice_files/
