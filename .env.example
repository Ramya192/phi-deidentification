# Copy this file to .env and fill in real values -- .env is gitignored,
# .env.example is not, so this is the template that actually ships in the
# repo. Loaded automatically by api/main.py and app/streamlit_app.py via
# python-dotenv if a .env file exists; harmless no-op if it doesn't.
# Every variable below is left uncommented on purpose -- this is the full
# set the app reads, all in one place, so nothing is hidden behind a "#".

# Master switch: "local" or "prod". This one line decides
# PHI_DEID_EMBED_API and PHI_DEID_SPACY_MODEL below automatically, so
# switching contexts means changing this one value instead of two.
#   local -- two-process dev: run api/main.py (uvicorn) and
#            app/streamlit_app.py (streamlit run) as separate processes,
#            full-size en_core_web_lg detection model.
#   prod  -- single-process deployment (e.g. Streamlit Community Cloud,
#            which only runs one entrypoint): app/streamlit_app.py starts
#            the FastAPI backend itself in a background thread, and
#            switches to the smaller en_core_web_sm model to fit the
#            platform's 1GB RAM cap.
# If you leave this blank, PHI_DEID_EMBED_API and PHI_DEID_SPACY_MODEL
# below are read directly instead (old behavior, for deployments that set
# those two individually rather than using this switch).
PHI_DEID_ENV=local

# Required for every PHI-handling API endpoint. Any string you choose --
# not tied to any external account. If unset, the API auto-generates a
# random one at startup and prints it to the console (fine for a quick
# local test, but every restart gets a new key, and the Streamlit sidebar
# can't auto-fill a key it doesn't know).
PHI_DEID_API_KEY=dev-local-key

# Optional. A second key that can read/list every caller's audit records
# via GET /records and GET /records/{id}/audit regardless of X-Client-Id
# (see storage/audit_store.py's client_id scoping). Leave unset unless an
# operator specifically needs cross-client visibility -- with it unset,
# nobody gets that access.
# PHI_DEID_ADMIN_API_KEY=dev-local-admin-key

# Set to "llm" to enable GPT-4o-mini-based classification instead of the
# zero-API-key heuristic. "heuristic" (or anything else) keeps the
# default, zero-cost behavior -- see README's "LLM classification
# (optional)" section.
PHI_DEID_CLASSIFICATION_BACKEND=heuristic

# Set to "llm" to enable the agentic adjudication tier (tool-calling +
# structured-output review of low-confidence spans) instead of the
# default no-op pass-through. "heuristic" (or anything else) keeps the
# default, zero-cost behavior -- see README's "LLM adjudication agent"
# section.
PHI_DEID_ADJUDICATION_BACKEND=heuristic

# Required only if PHI_DEID_CLASSIFICATION_BACKEND=llm and/or
# PHI_DEID_ADJUDICATION_BACKEND=llm. Get one from
# https://platform.openai.com/api-keys -- never commit the real value.
OPENAI_API_KEY=sk-your-key-here

# PHI_DEID_ENV above is authoritative when set to "local" or "prod" -- it
# overrides these two values automatically, so you normally don't need to
# touch them. They're shown uncommented, set to what "local" resolves to,
# purely so nothing in this file is hidden. To take manual control of
# these two individually instead, leave PHI_DEID_ENV blank above -- then
# whatever you set here is read directly.
PHI_DEID_EMBED_API=0
PHI_DEID_SPACY_MODEL=en_core_web_lg
